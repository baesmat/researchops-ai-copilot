FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir . && useradd -m appuser
USER appuser

ENV APP_HOST=0.0.0.0 APP_PORT=8410 \
    APP_DB_PATH=/data/copilot.db APP_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8410

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:%s/healthz'%os.environ.get('APP_PORT','8410')).read()"

CMD ["python", "-m", "app.main"]
