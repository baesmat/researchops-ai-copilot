# Copy to .env or export in your shell. Nothing here is secret.
# --- Model endpoint (any OpenAI-compatible API) ---
LLM_BASE_URL=http://127.0.0.1:8893/v1     # e.g. the local bridge, or your vLLM/LiteLLM/whatever
LLM_MODEL=GLM-5.3-Flash-EXL3
LLM_API_KEY=                               # leave empty if the endpoint needs no auth
LLM_TIMEOUT_SECONDS=240
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- App ---
APP_HOST=127.0.0.1                         # localhost-only by default
APP_PORT=8410
APP_DB_PATH=data/copilot.db
APP_DATA_DIR=data
MAX_UPLOAD_MB=15
DOC_RETENTION_DAYS=0                       # 0 = keep until deleted via the UI/API

# --- Frontend ---
API_BASE=http://127.0.0.1:8410
