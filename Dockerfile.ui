FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README ./
COPY app ./app
COPY frontend ./frontend
RUN pip install --no-cache-dir . streamlit && useradd -m appuser
USER appuser

ENV API_BASE=http://api:8410
EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
